# -------------------------------------------------------------
# HotelOS Backend Configuration
# -------------------------------------------------------------

# Application Environment: development | staging | production
ENVIRONMENT="development"
ENABLE_DEMO_SEEDING="true"
PROJECT_NAME="HotelOS"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL / Supabase or SQLite fallback)
# Production Supabase PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# Local Development SQLite fallback:
DATABASE_URL="sqlite+aiosqlite:///./hotelos.db"

# Hotel Defaults
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# Supabase Auth & Storage (Optional for cloud storage)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_JWT_SECRET=""

# WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Transactional Email (Resend or AWS SES)
RESEND_API_KEY=""

# AI Hotel Operations Assistant
# Provider options: auto | gemini | openai | deterministic
AI_PROVIDER="auto"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_MAX_TOKENS=1000

